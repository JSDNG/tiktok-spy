# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tiktok_spy

# Dùng bởi docker-compose.yml (${POSTGRES_PASSWORD}) cho service postgres + DATABASE_URL trong container
POSTGRES_PASSWORD=

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Apify — provider spy TikTok Shop (docs/04-integration/external-spy-api.md)
APIFY_TOKEN=
APIFY_ACTOR_ID=devcake~tiktok-shop-data-scraper

# Chuẩn hoá dữ liệu spy
SPY_DEFAULT_CURRENCY=USD
SPY_MAX_PRODUCTS=20

# Job polling (worker chờ kết quả từ Apify — actor có timeout nội bộ 60s)
POLL_INITIAL_DELAY_MS=20000
POLL_INTERVAL_MS=10000
POLL_TIMEOUT_MS=180000

# Auth.js
AUTH_SECRET=
AUTH_SESSION_MAX_AGE=604800

# Seed user — dùng làm userId cố định trước khi auth được cắm vào (xem ADR-0005)
SEED_USER_EMAIL=devdragon@gmail.com
SEED_USER_PASSWORD=DevDragon2026
